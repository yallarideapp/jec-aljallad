{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard, or the build fails.
  "name": "jec-aljallad",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    // npm run build copies the site's runtime files here (tools/build-dist.mjs)
    "directory": "./dist",
    "binding": "ASSETS",
    // only the videos played by <video> pass through the Worker, for byte-range answers
    "run_worker_first": ["/media/*"]
  },
  "observability": { "enabled": true }
}
